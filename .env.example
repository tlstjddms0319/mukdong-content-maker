OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_TEXT_MODEL=gemini-3.1-flash-lite
# 무료 문안 AI 예비 (선택): console.groq.com 에서 키 발급. 카드 불필요.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Cloudflare 문안 모델 (선택): 이미지와 같은 계정·토큰을 사용하며 하루 10,000뉴런을 함께 씁니다.
CLOUDFLARE_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
# Higgsfield 이미지 AI: console.higgsfield.ai 에서 발급한 키 ID와 시크릿을 각각 넣으세요. 서버 환경변수에만 저장합니다.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# 네이버 검색어 트렌드(선택): NAVER API HUB에서 발급한 키. 예전 개발자센터 키라면 NAVER_API_STYLE=legacy.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
DATA_DIR=./data

# 배포용 영구 보관 (선택): Supabase의 private Storage bucket `mukdong-private`를 만든 뒤 두 값을 함께 설정하세요.
# 비밀키는 서버 환경변수에만 저장하고 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 관리자 로그인: .\scripts\setup-owner-password.ps1 실행 결과를 .env.local 또는 배포 환경변수에만 저장하세요.
OWNER_PASSWORD_HASH=
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Instagram 연결은 Meta 앱 생성 후 .env.local에만 입력하세요.
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
MEDIA_PUBLIC_BASE_URL=https://your-deployed-app.example.com
MEDIA_SIGNING_SECRET=replace_with_a_long_random_value
# 예약 자동 게시: 서버가 켜져 있는 동안 1분마다 게시 예정 초안을 확인합니다. 끄려면 off.
INSTAGRAM_AUTOPUBLISH=on
INSTAGRAM_SCHEDULER_INTERVAL_SECONDS=60
# 외부 크론이 POST /api/instagram/scheduler 를 부를 때 쓰는 비밀값 (Authorization: Bearer ...). 긴 랜덤 문자열.
INSTAGRAM_SCHEDULER_SECRET=
